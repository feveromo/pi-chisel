{
	"name": "pi-chisel",
	"version": "0.1.2",
	"description": "Turn rough drafts into clear prompts in Pi: review, compare, and refine before replacing your editor text. Never auto-submits.",
	"license": "MIT",
	"author": "feveromo",
	"homepage": "https://github.com/feveromo/pi-chisel/tree/pi#readme",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feveromo/pi-chisel.git"
	},
	"bugs": {
		"url": "https://github.com/feveromo/pi-chisel/issues"
	},
	"type": "module",
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"SECURITY.md",
		"docs"
	],
	"keywords": [
		"pi-package",
		"prompt-optimizer",
		"terminal"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/prompt-optimizer.ts"
		],
		"image": "https://cdn.jsdelivr.net/npm/pi-chisel@0.1.2/docs/images/pi-chisel-review.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"scripts": {
		"format": "biome check --write src test package.json tsconfig.json --files-ignore-unknown=true",
		"lint": "biome check src test package.json tsconfig.json --files-ignore-unknown=true",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:smoke": "python3 test/smoke-tui.py",
		"test:capture": "python3 -m unittest discover -s test -p 'test_*.py'",
		"smoke:configured": "bash test/smoke-configured.sh",
		"pack:check": "npm pack --dry-run --ignore-scripts",
		"validate": "npm run lint && npm run check && npm test && npm run test:capture && npm run pack:check && npm run test:smoke && npm run smoke:configured"
	}
}
